# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Exfat
CONFIG_EXFAT_FS=y

# Platform
CONFIG_MACH_RAZER_NICOLE=y
CONFIG_OCP_IRQ=y
CONFIG_QUECTEL_MODULE_RESET=y

# RNDIS
CONFIG_USB_CONFIGFS_RNDIS=y

# Touchscreen
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_TOUCHSCREEN_FTS_SPI=m
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y

# Vibrator
CONFIG_HAPTIC_NV=y

# Wifi
CONFIG_QCA_CLD_WLAN=m
CONFIG_CNSS_QCA6490=y
