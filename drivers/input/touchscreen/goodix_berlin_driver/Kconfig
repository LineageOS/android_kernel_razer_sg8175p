#
# Goodix touchscreen driver configuration
#
menuconfig TOUCHSCREEN_GOODIX_BRL
	tristate "Goodix berlin touchscreen"
	help
	  Say Y here if you have a Goodix berlin series touch controller
	  to your system.

	  If build module, say M.
	  If unsure, say N.

if TOUCHSCREEN_GOODIX_BRL

config TOUCHSCREEN_GOODIX_BRL_I2C
	bool "support I2C bus connection"
	help
		Say Y here if the touchscreen is connected via I2C bus.

config TOUCHSCREEN_GOODIX_BRL_SPI
	bool "support SPI bus connection"
	help
		Say Y here if the touchscreen is connected via SPI bus.

config TOUCHSCREEN_GOODIX_BRL_GESTURE
	bool "support gesture"
	help
		Say Y here if support gesture

config TOUCHSCREEN_GOODIX_BRL_INSPECT
	bool "support gesture"
	help
		Say Y here if support inspect

config TOUCHSCREEN_GOODIX_BRL_TOOLS
	bool "support gesture"
	help
		Say Y here if support tools

config TOUCHSCREEN_GOODIX_BRL_FW_UPDATE
	bool "support gesture"
	help
		Say Y here if support fw update

endif
